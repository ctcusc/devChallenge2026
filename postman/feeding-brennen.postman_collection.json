{
  "info": {
    "name": "Feeding Brennen API",
    "description": "Contract for the Feeding Brennen REST API. The API is served by the Next.js app as route handlers under /api (http://localhost:3000/api).\n\nThe Restaurants requests assert the exact status codes the API must return, so you can run the whole collection (Postman Runner, or headless with `npx newman run postman/feeding-brennen.postman_collection.json`) to check your work against the contract in CHALLENGE.md.\n\nThe Visits requests are TEMPLATES. Visits are a real REST resource you design, so point these at whatever routes you chose (nested under a restaurant, top-level /api/visits, or both) before running them.\n\nStart everything first: `docker compose up -d`, then in client/: `npm run migrate && npm run seed && npm run dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "restaurantId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns { status: \"ok\" }', () => {",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Restaurants (fixed contract)",
      "item": [
        {
          "name": "GET /api/restaurants -> 200 + array",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is an array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants"]
            }
          }
        },
        {
          "name": "GET /api/restaurants/:id -> 200 + restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has id and name', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r).to.have.property('id');",
                  "  pm.expect(r).to.have.property('name');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}"]
            }
          }
        },
        {
          "name": "GET /api/restaurants/99999999 -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unknown id returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/99999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "99999999"]
            }
          }
        },
        {
          "name": "POST /api/restaurants (valid) -> 201 + created",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('returns the created restaurant with an id', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r).to.have.property('id');",
                  "  pm.expect(r.name).to.eql('Postman Diner');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Diner\",\n  \"cuisine\": \"American\",\n  \"address\": \"1 Test St\",\n  \"rating\": 4.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants"]
            }
          }
        },
        {
          "name": "POST /api/restaurants (rating 6) -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('out-of-range rating is rejected with 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Out Of Range\",\n  \"rating\": 6\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants"]
            }
          }
        },
        {
          "name": "POST /api/restaurants (missing name) -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing required field is rejected with 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuisine\": \"American\",\n  \"rating\": 4\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants"]
            }
          }
        },
        {
          "name": "PUT /api/restaurants/:id -> 200 + updated",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('reflects the update', () => {",
                  "  pm.expect(pm.response.json().name).to.eql('Updated Name');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"rating\": 4.0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}"]
            }
          }
        },
        {
          "name": "PUT /api/restaurants/99999999 -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('updating unknown id returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nope\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/99999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "99999999"]
            }
          }
        },
        {
          "name": "DELETE /api/restaurants/99999999 -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deleting unknown id returns 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/99999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "99999999"]
            }
          }
        }
      ]
    },
    {
      "name": "Visits (templates - point at your routes)",
      "item": [
        {
          "name": "List visits (your route)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/visits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "visits"]
            },
            "description": "If you nested visits under a restaurant instead, change the path to api/restaurants/:id/visits."
          }
        },
        {
          "name": "Create visit (your route) -> 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": 1,\n  \"date\": \"2026-04-01\",\n  \"amountSpent\": 25.00,\n  \"notes\": \"Lunch\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/visits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "visits"]
            },
            "description": "Adjust the path and body to match your chosen visit design."
          }
        },
        {
          "name": "Create visit for missing restaurant -> 4xx (not 500)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": 99999999,\n  \"date\": \"2026-04-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/visits",
              "host": ["{{baseUrl}}"],
              "path": ["api", "visits"]
            },
            "description": "A visit referencing a restaurant that does not exist must fail with a 4xx, not a 500."
          }
        }
      ]
    }
  ]
}
